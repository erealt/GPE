<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GPE.Logica\GPE.Logica.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>gpe.ico</ApplicationIcon>
    <AssemblyTitle>GPE</AssemblyTitle>
    <Product>GPE</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="gpe.ico" LogicalName="gpe.ico" />
  </ItemGroup>

  <!-- Conexión a la base de datos del servidor. Solo existe mientras Despliegue\preparar-paquete.ps1 publica -->
  <ItemGroup Condition="Exists('conexion.txt')">
    <Content Include="conexion.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Conexión de solo lectura a TenDB (nombres de proveedores). Lleva contraseña: no se sube a git -->
  <ItemGroup Condition="Exists('tendb.txt')">
    <Content Include="tendb.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>