@page "/acciones"
@layout LayoutTrabajadores
@inject NavigationManager Navegacion

<PageTitle>Mis acciones</PageTitle>

<div class="cabecera">
    <div>
        <h1>Mis acciones</h1>
        <p class="suave">Acciones de incidencias y no conformidades de las que eres responsable.</p>
    </div>
</div>

<div class="revisiones">
    <button class="revision @(verHechas ? "" : "elegida")" @onclick="() => Ver(false)">
        Pendientes@(acciones != null ? $" ({acciones.Count})" : "")
    </button>
    <button class="revision @(verHechas ? "elegida" : "")" @onclick="() => Ver(true)">Hechas</button>
</div>

@if (hecha != null)
{
    <div class="aviso bien">Apuntada como hecha: @hecha. Calidad ya lo ve en la ficha.</div>
}
@if (error != null)
{
    <div class="aviso error">@error</div>
}

@if (verHechas)
{
    @if (hechas == null)
    {
        @if (error == null)
        {
            <p class="suave">Cargando...</p>
        }
    }
    else if (hechas.Count == 0)
    {
        <div class="tarjeta vacio">No has hecho ninguna acción en el último mes.</div>
    }
    else
    {
        <p class="suave contador">Las que has hecho en el último mes</p>
        @foreach (var h in hechas)
        {
            <div class="tarjeta accion-trabajador accion-hecha">
                <div class="accion-cabecera">
                    <span class="numero">@Registro(h.TipoRegistro, h.NumeroNc)</span>
                    <span class="etiqueta verde">Hecha el @h.HechaEl.ToString("dd/MM/yyyy")</span>
                </div>
                <p class="accion-problema suave">@h.Problema</p>
                <div class="etiqueta-dato">@(h.Clase == "INMEDIATA" ? "ACCIÓN INMEDIATA" : "ACCIÓN CORRECTORA")</div>
                <p class="accion-texto">@h.Accion</p>
            </div>
        }
    }
}
else if (acciones == null)
{
    @if (error == null)
    {
        <p class="suave">Cargando...</p>
    }
}
else if (acciones.Count == 0)
{
    <div class="tarjeta vacio">No tienes ninguna acción pendiente.</div>
}
else
{
    <p class="suave contador">@acciones.Count @(acciones.Count == 1 ? "acción pendiente" : "acciones pendientes")</p>

    @foreach (var a in acciones)
    {
        <div class="tarjeta accion-trabajador">
            <div class="accion-cabecera">
                <span class="numero">@Registro(a.TipoRegistro, a.NumeroNc)</span>
                @if (a.Prioridad != null)
                {
                    <span class="etiqueta @ColorPrioridad(a.Prioridad)">@a.Prioridad</span>
                }
            </div>
            <p class="pequeno suave">
                Detectada el @a.FechaDetectado.ToString("dd/MM/yyyy")@(a.Seccion != null ? " · " + a.Seccion : "")
            </p>

            <div class="etiqueta-dato">QUÉ HA PASADO</div>
            <p class="accion-texto">@a.Problema</p>

            @if (!string.IsNullOrWhiteSpace(a.Causa))
            {
                <div class="etiqueta-dato">CAUSA</div>
                <p class="accion-texto">@a.Causa</p>
            }

            @if (a.Fotos.Count > 0)
            {
                @if (fotosAbiertas.Contains(a.Id))
                {
                    <div class="fotos-accion">
                        @foreach (var foto in a.Fotos)
                        {
                            <a href="acciones/foto/@foto" target="_blank"><img src="acciones/foto/@foto" alt="Foto" loading="lazy" /></a>
                        }
                    </div>
                }
                else
                {
                    <button class="secundario ver-fotos" @onclick="() => fotosAbiertas.Add(a.Id)">
                        Ver @(a.Fotos.Count == 1 ? "la foto" : $"las {a.Fotos.Count} fotos")
                    </button>
                }
            }
            <hr class="separador-accion" />

            <div class="etiqueta-dato">LO QUE TIENES QUE HACER · @(a.Clase == "INMEDIATA" ? "ACCIÓN INMEDIATA" : "ACCIÓN CORRECTORA")</div>
            <p class="accion-texto accion-tuya">@a.Accion</p>

            @if (a.Fecha != null)
            {
                <p class="pequeno @(a.Fecha < DateTime.Today ? "fuera-plazo" : "suave")">
                    Hacer antes del @a.Fecha.Value.ToString("dd/MM/yyyy")@(a.Fecha < DateTime.Today ? " · fuera de plazo" : "")
                </p>
            }

            @if (abierta == a.Id)
            {
                <div class="campo">
                    <label>
                        Comentario (opcional)
                        <textarea rows="3" placeholder="Qué has hecho, si quieres contarlo" @bind="comentario"></textarea>
                    </label>
                </div>
                <div class="acciones">
                    <button class="secundario" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
                    <button class="principal" @onclick="() => MarcarHecha(a)" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Confirmar")
                    </button>
                </div>
            }
            else
            {
                <button class="principal ancho" @onclick="() => Abrir(a.Id)">La he hecho</button>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> EstadoSesion { get; set; } = default!;

    private readonly TrabajadorWebServicio servicio = new();

    private string persona = "";
    private Usuario? usuario;        // para que el historial diga quién la ha marcado
    private List<AccionTrabajador>? acciones;
    private string? error;
    private string? hecha;           // la última marcada, para el aviso de arriba

    private bool verHechas;          // pestaña "Hechas"
    private List<AccionHecha>? hechas;
    private readonly HashSet<int> fotosAbiertas = new();

    private int? abierta;            // la que tiene abierto el comentario
    private string comentario = "";
    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        var sesion = (await EstadoSesion).User;
        if (!TrabajadorActual.HaEntrado(sesion))
        {
            Navegacion.NavigateTo("acciones/entrar");
            return;
        }
        // Quien solo es de Calidad no tiene "Mis acciones": va al control diario
        if (!TrabajadorActual.VeAcciones(sesion))
        {
            Navegacion.NavigateTo(TrabajadorActual.Inicio(sesion).TrimStart('/'));
            return;
        }
        usuario = TrabajadorActual.Usuario(sesion);
        persona = usuario!.Nombre;
        Cargar();
    }

    private void Cargar()
    {
        try
        {
            acciones = servicio.ObtenerPendientes(persona);
        }
        catch (DbException ex)
        {
            error = "No se han podido cargar tus acciones. " + ex.Message;
        }
        hechas = null;   // ha podido cambiar: se vuelve a leer al abrir la pestaña
    }

    private void Ver(bool verLasHechas)
    {
        verHechas = verLasHechas;
        hecha = null;
        error = null;
        if (!verHechas || hechas != null) return;
        try
        {
            hechas = servicio.ObtenerHechas(persona);
        }
        catch (DbException ex)
        {
            error = "No se han podido cargar las hechas. " + ex.Message;
        }
    }

    private void Abrir(int id)
    {
        abierta = id;
        comentario = "";
        hecha = null;
        error = null;
    }

    private void Cancelar() => abierta = null;

    private async Task MarcarHecha(AccionTrabajador accion)
    {
        guardando = true;
        error = null;
        await Task.Yield();   // para que se vea "Guardando..." mientras tanto

        try
        {
            using (Sesion.Como(usuario!))
                servicio.MarcarHecha(accion.Id, persona, comentario);
            hecha = Registro(accion.TipoRegistro, accion.NumeroNc);
            abierta = null;
        }
        catch (ReglaNegocioException ex)
        {
            error = ex.Message;
            abierta = null;
        }
        catch (DbException ex)
        {
            // Se deja abierta con el comentario escrito para que pueda volver a intentarlo
            error = "No se ha podido guardar. Prueba otra vez. " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
        Cargar();
    }

    private static string Registro(string tipoRegistro, string? numero) =>
        (tipoRegistro == "INCIDENCIA" ? "Incidencia" : tipoRegistro == "MEJORA" ? "Mejora" : "NC")
        + (numero != null ? " " + numero : "");

    private static string ColorPrioridad(string prioridad) => prioridad switch
    {
        "Alta" => "roja",
        "Media" => "ambar",
        _ => "gris"
    };
}
