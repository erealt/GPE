@* Ficha de incidencia, no conformidad o acción de mejora para la web (nueva, o una ya guardada si
   Borrador.Id no es 0, para añadirle algo): las mismas fases y campos
   que FormNoConformidad del escritorio (registro, clasificación, fotos, acción inmediata, análisis con
   los 5 porqués, corrección y cierre), con las mismas reglas del servicio. *@

<div class="ficha-nc" data-borrador="@ClaveBorrador">
    @if (recuperada)
    {
        <div class="aviso bien">Se ha recuperado lo que estabas escribiendo en esta ficha.</div>
    }
    <div class="ficha-fases">
        @foreach (var (fase, i) in Fases().Select((f, i) => (f, i)))
        {
            <span class="ficha-fase @(fase.Hecha ? "hecha" : "")">
                @(fase.Hecha ? "✓ " : "")@(i + 1). @TextoFase(fase.Fase)@(fase.Opcional && !fase.Hecha ? " (opcional)" : "")
            </span>
        }
    </div>

    @* 1. Registro *@
    <section class="ficha-tarjeta">
        <h3>1. Registro</h3>
        <p class="suave pequeno">Qué es, cuándo se detectó, de dónde viene y quién se encarga</p>

        <div class="campo">
            <span class="etiqueta-campo">Tipo de registro</span>
            <div class="opciones">
                @foreach (var tipo in TipoRegistro.Todos)
                {
                    <label class="opcion">
                        <input type="radio" name="tipo-registro" checked="@(f.Tipo == tipo)" disabled="@guardando"
                               @onchange="() => CambiarTipo(tipo)" />
                        @TipoRegistro.Nombre(tipo)
                    </label>
                }
            </div>
            @if (Error(nameof(NoConformidad.TipoRegistro)) is string errorTipo)
            {
                <span class="error-campo">@errorTipo</span>
            }
        </div>

        <div class="rejilla-ficha">
            <Campo Etiqueta="Nº">
                <input value="@(numeroPrevisto ?? "Sin número")" readonly />
                <span class="pequeno suave">@(numeroPrevisto == null ? "Las acciones de mejora no llevan número."
                    : Borrador.Id != 0 && numeroPrevisto == Borrador.Numero ? "Ya guardado." : "Automático: se asigna al guardar.")</span>
            </Campo>
            <Campo Etiqueta="Fecha detectado" Error="@Error(nameof(NoConformidad.FechaDetectado))">
                <input type="date" max="@Hoy" @bind="f.FechaDetectado" @bind:after="ActualizarNumero" disabled="@guardando" />
            </Campo>
            @* Solo los cuatro de ahora, y no en incidencias (26/11) *@
            @if (NoConformidadServicio.LlevaOrigen(f.Tipo))
            {
                <Campo Etiqueta="Origen" Error="@Error(nameof(NoConformidad.Origen))">
                    <select @bind="f.Origen" @bind:after="CambiarOrigen" disabled="@guardando">
                        @Opciones(ListaCalidad.Origen, f.Origen, o => NoConformidadServicio.Origenes.Contains(o.Valor))
                    </select>
                </Campo>
            }
            <Campo Etiqueta="Cliente" Error="@Error(nameof(NoConformidad.Cliente))">
                <input list="clientes-nc" maxlength="150" @bind="f.Cliente" disabled="@guardando" />
                <datalist id="clientes-nc">
                    @foreach (var cliente in clientes)
                    {
                        <option value="@cliente"></option>
                    }
                </datalist>
            </Campo>
            <Campo Etiqueta="Proveedor" Error="@Error(nameof(NoConformidad.Proveedor))">
                <select @bind="f.ProveedorId" disabled="@guardando">
                    <option value="">—</option>
                    @foreach (var p in proveedores.Where(p => !p.Baja))
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </Campo>
            @* La sección y el tipo de no conformidad ya no se piden (26/11) *@
        </div>

        <Campo Etiqueta="Problema" Error="@Error(nameof(NoConformidad.Problema))">
            <textarea rows="4" placeholder="Qué se ha detectado: producto, lote, cliente..." @bind="f.Problema" @bind:event="oninput" disabled="@guardando"></textarea>
        </Campo>

        @if (f.Tipo == TipoRegistro.NoConformidad && f.ProveedorId != null)
        {
            <div class="rejilla-ficha">
                <Campo Etiqueta="¿Afecta a la seguridad alimentaria?" Error="@Error(nameof(NoConformidad.SeguridadAlimentaria))">
                    <select @bind="f.Seguridad" disabled="@guardando">
                        <option value="">—</option>
                        <option value="si">Sí, afecta</option>
                        <option value="no">No afecta</option>
                    </select>
                    <span class="pequeno suave">Cuenta para la nota de reclamaciones del proveedor.</span>
                </Campo>
            </div>
        }
    </section>

    @* En incidencias y, desde el 26/11, también en NC; los operarios, solo en incidencias *@
    @if (f.Tipo is TipoRegistro.Incidencia or TipoRegistro.NoConformidad)
    {
        <section class="ficha-tarjeta">
            <h3>Clasificación</h3>
            <p class="suave pequeno">El parámetro y, dentro de él, el MC, PCC o buena práctica a la que afecta</p>
            @* Parámetro y, debajo, sus opciones, con botones como la causa raíz (26/11) *@
            <div class="campo">
                <span class="etiqueta-campo" id="etiqueta-parametro">Parámetro</span>
                @Botones("parametro", "etiqueta-parametro", ConGuardado(ParametrosIncidencia.Todos, f.Parametro), f.Parametro, ElegirParametro)
            </div>
            @if (f.Parametro != null || f.McPccBpm != null)
            {
                <div class="campo subgrupos">
                    <span class="etiqueta-campo" id="etiqueta-mc-pcc-bpm">MC / PCC / BPM@(f.Parametro == null ? "" : $" · {f.Parametro}")</span>
                    @Botones("mc-pcc-bpm", "etiqueta-mc-pcc-bpm", ConGuardado(ParametrosIncidencia.Opciones(f.Parametro), f.McPccBpm),
                             f.McPccBpm, o => f.McPccBpm = o)
                </div>
            }
            @if (f.Tipo == TipoRegistro.Incidencia)
            {
            <div class="rejilla-ficha">
                @* Puede haber varios (25/11): se eligen de uno en uno y salen debajo con su ✕.
                   El desplegable va primero porque la etiqueta activa el primer control de dentro. *@
                <Campo Etiqueta="Operarios causantes" Error="@Error(nameof(NoConformidad.Operario))">
                    @{ var elegidos = NoConformidadServicio.Operarios(f.Operario); }
                    <select @key="anadidosOperario" @onchange="AnadirOperario" disabled="@guardando">
                        <option value="">@(elegidos.Count == 0 ? "—" : "Añadir otro…")</option>
                        @foreach (var o in listas.GetValueOrDefault(ListaCalidad.Operario) ?? new())
                        {
                            @if (!elegidos.Contains(o.Valor, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@o.Valor">@o</option>
                            }
                        }
                    </select>
                    @foreach (var o in elegidos)
                    {
                        <span class="operario-elegido">
                            @o
                            <button type="button" class="quitar" title="Quitar" disabled="@guardando"
                                    @onclick="() => QuitarOperario(o)" @onclick:preventDefault>✕</button>
                        </span>
                    }
                </Campo>
            </div>
            }
        </section>
    }

    <section class="ficha-tarjeta">
        <h3>Fotos</h3>
        <p class="suave pequeno">Fotos del problema. Van adjuntas en el correo a los responsables de las acciones nuevas.</p>
        @* "Hacer foto" abre la cámara trasera del móvil (capture); en el ordenador, como la galería.
           La clave cambia tras cada selección para poder elegir otra vez la misma foto. *@
        <div class="botones-foto" @key="selecciones">
            <label class="principal boton-foto @(guardando || leyendoFotos ? "desactivado" : "")">
                📷 Hacer foto
                <InputFile accept="image/*" capture="environment" OnChange="AnadirFotos" disabled="@(guardando || leyendoFotos)" />
            </label>
            <label class="secundario boton-foto @(guardando || leyendoFotos ? "desactivado" : "")">
                🖼 Elegir de la galería
                <InputFile accept="image/*" multiple OnChange="AnadirFotos" disabled="@(guardando || leyendoFotos)" />
            </label>
        </div>
        @if (errorFotos != null)
        {
            <p class="error-campo">@errorFotos</p>
        }
        @if (fotosGuardadas > 0)
        {
            <p class="suave pequeno">Ya tiene @fotosGuardadas @(fotosGuardadas == 1 ? "foto guardada" : "fotos guardadas"). Las que hagas ahora se añaden.</p>
        }
        @if (leyendoFotos)
        {
            <p class="suave pequeno">Cargando fotos...</p>
        }
        @foreach (var foto in fotos)
        {
            <div class="foto-subida">
                <span>📷 @foto.NombreArchivo · @Tamano(foto.Contenido.Length)</span>
                <button class="quitar" disabled="@guardando" @onclick="() => QuitarFoto(foto)">✕</button>
            </div>
        }
    </section>

    @* 2. Acción inmediata *@
    <section class="ficha-tarjeta">
        <h3>2. Acción inmediata</h3>
        <p class="suave pequeno">Lo que se ha hecho en el momento para frenar el problema</p>
        @ListaAcciones(ClaseAccion.Inmediata, "Todavía no hay acciones inmediatas.", "+ Añadir acción inmediata")
    </section>

    @* 3. Análisis de la causa *@
    <section class="ficha-tarjeta">
        <h3>3. Análisis de la causa</h3>
        @* Los 5 porqués, solo en las NC (25/11) *@
        @if (f.Tipo == TipoRegistro.NoConformidad)
        {
            <p class="suave pequeno">Por qué ha pasado: se pregunta por qué hasta cinco veces y se elige el grupo de la causa raíz a la que se llega</p>
            <span class="etiqueta-campo">5 porqués</span>
            @for (int i = 0; i < NoConformidad.NumeroPorQues; i++)
            {
                var n = i;
                <div class="porque">
                    <strong>@(n + 1).</strong>
                    <textarea rows="2" maxlength="1000" placeholder="@(n == 0 ? "¿Por qué ha pasado...?" : "¿Por qué...?")"
                              @bind="f.Preguntas[n]" @bind:event="oninput" disabled="@guardando"></textarea>
                    <textarea rows="2" maxlength="1000" placeholder="Porque..."
                              @bind="f.Respuestas[n]" @bind:event="oninput" disabled="@guardando"></textarea>
                </div>
            }
        }
        else
        {
            <p class="suave pequeno">Por qué ha pasado: el grupo de la causa raíz</p>
        }
        @* Grupo y subgrupo a la vista, con un clic, como el tipo de registro (26/11) *@
        <div class="campo">
            <span class="etiqueta-campo" id="etiqueta-causa-raiz">Causa raíz</span>
            @Botones("causa-raiz", "etiqueta-causa-raiz", ConGuardado(CausasRaiz.Todas, f.CausaRaiz), f.CausaRaiz, ElegirCausaRaiz)
        </div>
        @if (f.CausaRaiz != null)
        {
            <div class="campo subgrupos">
                <span class="etiqueta-campo" id="etiqueta-subgrupo">Subgrupo de @f.CausaRaiz</span>
                @Botones("causa-raiz-subgrupo", "etiqueta-subgrupo", ConGuardado(CausasRaiz.Subgrupos(f.CausaRaiz), f.CausaRaizSubgrupo),
                         f.CausaRaizSubgrupo, s => f.CausaRaizSubgrupo = s)
            </div>
        }
        <div class="rejilla-ficha">
            <Campo Etiqueta="Capítulo de la norma">
                <select @bind="f.Capitulo" disabled="@guardando">@Opciones(ListaCalidad.CapituloNorma, f.Capitulo)</select>
            </Campo>
        </div>
    </section>

    @* 4. Acción correctora *@
    <section class="ficha-tarjeta">
        <h3>4. Acción correctora</h3>
        <p class="suave pequeno">Para que no vuelva a pasar. La fase queda hecha cuando todas las acciones están hechas</p>
        @ListaAcciones(ClaseAccion.Correctora, "Todavía no hay acciones correctoras.", "+ Añadir acción correctora")
        <div class="rejilla-ficha">
            <Campo Etiqueta="Coste económico (€)" Error="@(errorCoste ?? Error(nameof(NoConformidad.CosteEconomico)))">
                <input inputmode="decimal" placeholder="Ej. 180,50" @bind="f.Coste" disabled="@guardando" />
            </Campo>
            <Campo Etiqueta="Horas de mano de obra" Error="@(errorHoras ?? Error(nameof(NoConformidad.HorasManoObra)))">
                <input inputmode="decimal" placeholder="Ej. 1,5" @bind="f.Horas" disabled="@guardando" />
            </Campo>
        </div>
    </section>

    @* 5. Verificación y cierre *@
    <section class="ficha-tarjeta">
        <h3>5. Verificación y cierre</h3>
        <p class="pequeno suave">@TextoEstado()</p>
        @ListaAcciones(ClaseAccion.Seguimiento,
            "Todavía no hay seguimientos. Añade uno cada vez que se compruebe si las acciones han funcionado.", "+ Añadir seguimiento")
        <div class="rejilla-ficha">
            <Campo Etiqueta="Fecha fin" Error="@Error(nameof(NoConformidad.FechaFin))">
                <input type="date" max="@Hoy" @bind="f.FechaFin" disabled="@guardando" />
            </Campo>
        </div>
    </section>

    @if (errorGeneral != null)
    {
        <div class="aviso error">@errorGeneral</div>
    }
    @if (hayErrores)
    {
        <div class="aviso error">Revisa los campos marcados en rojo.</div>
    }
    <div class="acciones">
        <button class="secundario" disabled="@guardando" @onclick="OnCancelar">Ahora no</button>
        <button class="principal" disabled="@(guardando || leyendoFotos)" @onclick="Guardar">
            @(guardando ? "Guardando..." : "Guardar registro")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NoConformidad Borrador { get; set; } = default!;
    [Parameter, EditorRequired] public Usuario Usuario { get; set; } = default!;
    // Al guardar: el id y el registro tal como se ha guardado
    [Parameter] public EventCallback<(int Id, NoConformidad Registro, string? AvisoProveedor)> OnGuardado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }
    // Si se pasa, lo escrito y las fotos se van guardando en el móvil con esta clave (gpe.borradorNc)
    // y al abrir la ficha se recupera lo que hubiera. Lo borra quien abre la ficha, al guardarla o cerrarla.
    [Parameter] public string? ClaveBorrador { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private readonly NoConformidadServicio servicio = new();
    private static string Hoy => DateTime.Today.ToString("yyyy-MM-dd");

    // Lo que se va escribiendo en la ficha
    private sealed class Ficha
    {
        public string Tipo { get; set; } = TipoRegistro.Incidencia;
        public DateTime FechaDetectado { get; set; } = DateTime.Today;
        public string? Origen { get; set; }
        public string? Seccion { get; set; }
        public string? TipoNc { get; set; }
        public string? Cliente { get; set; }
        public int? ProveedorId { get; set; }
        public string? Seguridad { get; set; }   // "si", "no" o vacío
        public string Problema { get; set; } = "";
        public DateTime? FechaPrevista { get; set; }
        public DateTime? FechaFin { get; set; }
        public string? McPccBpm { get; set; }
        public string? Parametro { get; set; }
        public string? Operario { get; set; }
        public string?[] Preguntas { get; set; } = new string?[NoConformidad.NumeroPorQues];
        public string?[] Respuestas { get; set; } = new string?[NoConformidad.NumeroPorQues];
        public string? CausaRaiz { get; set; }
        public string? CausaRaizSubgrupo { get; set; }
        public string? Capitulo { get; set; }
        public string? Coste { get; set; }
        public string? Horas { get; set; }
    }

    // Una fila de las tablas de acciones del escritorio (TablaAcciones)
    private sealed class FilaAccion
    {
        public int Id { get; set; }   // 0: nueva; si no, la guardada (para no borrarla y volver a crearla)
        public required string Clase { get; init; }
        public bool Hecha { get; set; }
        public string Accion { get; set; } = "";
        public DateTime? Fecha { get; set; }
        public string? Responsable { get; set; }
        public string? Prioridad { get; set; }
        public string? Observaciones { get; set; }
        [System.Text.Json.Serialization.JsonIgnore] public string? Error { get; set; }

        public bool Vacia => !Hecha && string.IsNullOrWhiteSpace(Accion) && Fecha == null
            && string.IsNullOrWhiteSpace(Responsable) && string.IsNullOrWhiteSpace(Prioridad) && string.IsNullOrWhiteSpace(Observaciones);

        public AccionNc Leer() =>
            NoConformidadServicio.NormalizarAccion(new AccionNc(Id, Clase, Accion, Fecha, Responsable, Observaciones, Hecha, Prioridad));
    }

    private Ficha f = new();
    private List<FilaAccion> acciones = new();
    private readonly List<ArchivoNuevo> fotos = new();
    private int fotosGuardadas;   // las que ya tiene un registro guardado: se quedan, las nuevas se añaden

    // Lo que se guarda en el móvil (las fotos van aparte)
    private sealed record Guardado(Ficha Ficha, List<FilaAccion> Acciones);
    private bool borradorListo;      // no se escribe hasta haber leído lo que hubiera
    private bool guardada;           // ni después de guardar
    private string? ultimoGuardado;
    private bool recuperada;

    private Dictionary<string, List<OpcionLista>> listas = new();
    private List<string> clientes = new();
    private List<ProveedorDeLista> proveedores = new();
    private string? numeroPrevisto;

    private List<(string Campo, string Mensaje)> errores = new();
    private string? errorCoste, errorHoras, errorGeneral, errorFotos;
    private bool hayErrores;
    private bool guardando, leyendoFotos;
    private int selecciones;

    protected override void OnInitialized()
    {
        var b = Borrador;
        f = new Ficha
        {
            Tipo = b.TipoRegistro,
            FechaDetectado = b.FechaDetectado,
            Origen = b.Origen,
            Seccion = b.Seccion,
            TipoNc = b.Tipo,
            Cliente = b.Cliente,
            ProveedorId = b.ProveedorId,
            Seguridad = b.SeguridadAlimentaria switch { true => "si", false => "no", null => null },
            Problema = b.Problema,
            FechaPrevista = b.FechaPrevista,
            FechaFin = b.FechaFin,
            McPccBpm = b.McPccBpm,
            Parametro = b.Parametro,
            Operario = b.Operario,
            Preguntas = Enumerable.Range(0, NoConformidad.NumeroPorQues).Select(i => b.PorQues?.ElementAtOrDefault(i)?.Pregunta).ToArray(),
            Respuestas = Enumerable.Range(0, NoConformidad.NumeroPorQues).Select(i => b.PorQues?.ElementAtOrDefault(i)?.Respuesta).ToArray(),
            CausaRaiz = b.CausaRaiz,
            CausaRaizSubgrupo = b.CausaRaizSubgrupo,
            Capitulo = b.CapituloNorma,
            Coste = b.CosteEconomico?.ToString("0.##", new System.Globalization.CultureInfo("es-ES")),
            Horas = b.HorasManoObra?.ToString("0.##", new System.Globalization.CultureInfo("es-ES"))
        };
        try
        {
            listas = servicio.ObtenerListas();
            clientes = servicio.ObtenerClientes();
            proveedores = servicio.ObtenerProveedores();
            // Ya guardado (se vuelve a abrir para añadir algo): sus acciones y cuántas fotos tiene
            if (b.Id != 0)
            {
                acciones = servicio.ObtenerAcciones(b.Id).Select(a => new FilaAccion
                {
                    Id = a.Id, Clase = a.Clase, Hecha = a.Hecha, Accion = a.Accion, Fecha = a.Fecha,
                    Responsable = a.Responsable, Prioridad = a.Prioridad, Observaciones = a.Observaciones
                }).ToList();
                fotosGuardadas = servicio.ObtenerFotos(b.Id).Count;
            }
        }
        catch (DbException ex)
        {
            errorGeneral = "No se han podido leer las listas de calidad. Comprueba la conexión. " + ex.Message;
        }
        ActualizarNumero();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ClaveBorrador == null) return;
        try
        {
            if (firstRender)
            {
                await Recuperar();
                borradorListo = true;
                return;
            }
            // Ya guardada: quien abrió la ficha borra el borrador; si se escribiera otra vez, al volver
            // a entrar se recuperaría lo de antes como si no se hubiera guardado
            if (!borradorListo || guardada) return;
            // Después de cada cambio: es poco texto, se escribe entero
            string json = System.Text.Json.JsonSerializer.Serialize(new Guardado(f, acciones));
            if (json == ultimoGuardado) return;
            await JS.InvokeVoidAsync("gpe.borradorNc.guardar", ClaveBorrador, json);
            ultimoGuardado = json;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Sin guardar en el móvil la ficha funciona igual
        }
    }

    // Lo escrito y las fotos que se guardaron en el móvil antes de que se recargara la página
    private async Task Recuperar()
    {
        bool hay = false;
        if (await JS.InvokeAsync<string?>("gpe.borradorNc.leer", ClaveBorrador) is string json
            && System.Text.Json.JsonSerializer.Deserialize<Guardado>(json) is Guardado guardado)
        {
            f = guardado.Ficha;
            acciones = guardado.Acciones;
            ultimoGuardado = json;
            hay = true;
        }

        var enMovil = await JS.InvokeAsync<List<FotoEnMovil>>("gpe.borradorNc.fotos", ClaveBorrador);
        for (int i = 0; i < enMovil.Count; i++)
        {
            var (nombre, tamano) = (enMovil[i].Nombre, enMovil[i].Tamano);
            // Ya está si la página no se recargó y llegó al servidor
            if (fotos.Any(x => x.NombreArchivo == nombre && x.Contenido.Length == tamano)) continue;
            if (NoConformidadServicio.ErrorFoto(nombre, tamano) != null) continue;
            var referencia = await JS.InvokeAsync<IJSStreamReference>("gpe.borradorNc.foto", ClaveBorrador, i);
            await using var flujo = await referencia.OpenReadStreamAsync(NoConformidadServicio.TamanoMaximoFoto);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria);
            fotos.Add(new ArchivoNuevo(nombre, memoria.ToArray()));
            hay = true;
        }

        if (hay)
        {
            recuperada = true;
            ActualizarNumero();
            StateHasChanged();
        }
    }

    private sealed record FotoEnMovil(string Nombre, long Tamano);

    // Al cambiar de grupo se vacía el subgrupo: el de antes es de otro grupo
    private void ElegirCausaRaiz(string? grupo)
    {
        if (f.CausaRaiz != grupo)
        {
            f.CausaRaiz = grupo;
            f.CausaRaizSubgrupo = null;
        }
    }

    // Cambia la clave del desplegable de operarios para que vuelva a "Añadir otro…"
    private int anadidosOperario;

    private void AnadirOperario(ChangeEventArgs e)
    {
        if (e.Value is string nombre && nombre != "")
            f.Operario = NoConformidadServicio.UnirOperarios(NoConformidadServicio.Operarios(f.Operario).Append(nombre));
        anadidosOperario++;
    }

    private void QuitarOperario(string nombre) =>
        f.Operario = NoConformidadServicio.UnirOperarios(
            NoConformidadServicio.Operarios(f.Operario).Where(o => !o.Equals(nombre, StringComparison.OrdinalIgnoreCase)));

    private async Task QuitarFoto(ArchivoNuevo foto)
    {
        fotos.Remove(foto);
        if (ClaveBorrador == null) return;
        try
        {
            await JS.InvokeVoidAsync("gpe.borradorNc.quitarFoto", ClaveBorrador, foto.NombreArchivo, foto.Contenido.Length);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    // Opciones de un desplegable; si el valor ya no está en la lista, se añade para no perderlo (como el escritorio)
    private RenderFragment Opciones(string lista, string? valor, Func<OpcionLista, bool>? filtro = null) => __builder =>
    {
        var opciones = (listas.GetValueOrDefault(lista) ?? new()).Where(o => filtro == null || filtro(o)).ToList();
        <option value="">—</option>
        @foreach (var o in opciones)
        {
            <option value="@o.Valor">@o</option>
        }
        @if (valor != null && !opciones.Any(o => o.Valor == valor))
        {
            <option value="@valor">@valor</option>
        }
    };

    // Opciones a la vista como botones, la primera "Sin indicar" (null): causa raíz, parámetro...
    private RenderFragment Botones(string nombre, string etiquetaId, IEnumerable<string> opciones, string? elegida,
        Action<string?> elegir) => __builder =>
    {
        <div class="opciones" role="radiogroup" aria-labelledby="@etiquetaId">
            @foreach (string? opcion in opciones.Prepend(null))
            {
                <label class="opcion">
                    <input type="radio" name="@nombre" checked="@(elegida == opcion)" disabled="@guardando"
                           @onchange="() => elegir(opcion)" />
                    @(opcion ?? "Sin indicar")
                </label>
            }
        </div>
    };

    // La lista y, si el valor guardado ya no está en ella (registro antiguo), también él, para no perderlo
    private static IEnumerable<string> ConGuardado(IEnumerable<string> lista, string? guardado) =>
        guardado == null || lista.Contains(guardado) ? lista : lista.Append(guardado);

    // Al cambiar de parámetro se vacía la opción: la de antes es de otro parámetro
    private void ElegirParametro(string? parametro)
    {
        if (f.Parametro != parametro)
        {
            f.Parametro = parametro;
            f.McPccBpm = null;
        }
    }

    private RenderFragment ListaAcciones(string clase, string vacia, string anadir) => __builder =>
    {
        bool seguimiento = clase == ClaseAccion.Seguimiento;
        var filas = acciones.Where(a => a.Clase == clase).ToList();
        var personas = (listas.GetValueOrDefault(ListaCalidad.Persona) ?? new()).Select(o => o.Valor).ToList();
        @if (filas.Count == 0)
        {
            <p class="suave pequeno">@vacia</p>
        }
        @foreach (var a in filas)
        {
            <div class="accion-nc @(a.Error != null ? "con-error" : "")">
                <div class="accion-cabeza">
                    @if (!seguimiento)
                    {
                        <label class="accion-hecha"><input type="checkbox" @bind="a.Hecha" disabled="@guardando" /> Hecha</label>
                    }
                    <button class="quitar" title="Quitar" disabled="@guardando" @onclick="() => acciones.Remove(a)">✕</button>
                </div>
                <textarea rows="2" maxlength="1000" placeholder="@(seguimiento ? "Comprobación" : "Acción")"
                          @bind="a.Accion" @bind:event="oninput" disabled="@guardando"></textarea>
                <div class="accion-datos">
                    <label><span>Fecha</span><input type="date" @bind="a.Fecha" disabled="@guardando" /></label>
                    <label>
                        <span>Responsable</span>
                        <select @bind="a.Responsable" disabled="@guardando">
                            <option value=""></option>
                            @foreach (var p in personas)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </label>
                    @if (!seguimiento)
                    {
                        <label>
                            <span>Prioridad</span>
                            <select @bind="a.Prioridad" disabled="@guardando">
                                <option value=""></option>
                                @foreach (var p in PrioridadAccion.Todas)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </label>
                    }
                </div>
                <input placeholder="Observaciones" maxlength="1000" @bind="a.Observaciones" disabled="@guardando" />
                @if (a.Error != null)
                {
                    <span class="error-campo">@a.Error</span>
                }
            </div>
        }
        <button class="secundario" disabled="@guardando" @onclick="() => AnadirAccion(clase)">@anadir</button>
    };

    private void AnadirAccion(string clase) =>
        // Un seguimiento casi siempre se apunta el mismo día en que se hace
        acciones.Add(new FilaAccion { Clase = clase, Fecha = clase == ClaseAccion.Seguimiento ? DateTime.Today : null });

    private void CambiarTipo(string tipo)
    {
        f.Tipo = tipo;
        ActualizarNumero();
    }

    private void CambiarOrigen() => ActualizarNumero();

    // El número depende del tipo
    private void ActualizarNumero()
    {
        try
        {
            numeroPrevisto = servicio.NumeroPrevisto(Registro(null, null), Borrador.Id != 0 ? Borrador : null);
        }
        catch (DbException)
        {
            numeroPrevisto = "Se asigna al guardar";
        }
    }

    private NoConformidad Registro(decimal? coste, decimal? horas)
    {
        var proveedor = proveedores.FirstOrDefault(p => p.Id == f.ProveedorId);
        return Borrador with
        {
            TipoRegistro = f.Tipo,
            FechaDetectado = f.FechaDetectado.Date,
            Origen = NoConformidadServicio.LlevaOrigen(f.Tipo) ? f.Origen : Borrador.Origen,
            Seccion = f.Seccion,
            Tipo = f.TipoNc,
            Cliente = f.Cliente,
            Proveedor = proveedor?.Nombre,
            ProveedorId = proveedor?.Id,
            SeguridadAlimentaria = f.Seguridad switch { "si" => true, "no" => false, _ => null },
            Problema = f.Problema ?? "",
            FechaPrevista = f.FechaPrevista,
            FechaFin = f.FechaFin,
            McPccBpm = f.McPccBpm,
            Parametro = f.Parametro,
            Operario = f.Operario,
            PorQues = Enumerable.Range(0, NoConformidad.NumeroPorQues).Select(i => new PorQue(f.Preguntas[i], f.Respuestas[i])).ToList(),
            CausaRaiz = f.CausaRaiz,
            CausaRaizSubgrupo = f.CausaRaizSubgrupo,
            CapituloNorma = f.Capitulo,
            CosteEconomico = coste,
            HorasManoObra = horas
        };
    }

    private List<EstadoFase> Fases() =>
        NoConformidadServicio.Fases(Registro(null, null),
            acciones.Where(a => !a.Vacia).Select(a => new AccionNc(0, a.Clase, a.Accion, null, null, null, a.Hecha)));

    // Cortos, como en la barra de fases del escritorio
    private static string TextoFase(string fase) => fase switch
    {
        FaseCalidad.Registro => "Registro",
        FaseCalidad.AccionInmediata => "Acción inmediata",
        FaseCalidad.Analisis => "Análisis",
        FaseCalidad.Correccion => "Corrección",
        FaseCalidad.Acciones => "Acciones de mejora",
        _ => "Verificación y cierre"
    };

    private string TextoEstado() =>
        NoConformidadServicio.Estado(f.FechaFin) == EstadoRegistro.Cerrada ? "Estado: cerrada." : "Estado: abierta.";

    private string? Error(string campo) =>
        errores.Where(e => e.Campo == campo).Select(e => e.Mensaje).FirstOrDefault();

    // "13.5" también vale: en español el punto se tomaría como separador de miles (como el escritorio)
    private static decimal? Numero(string? texto, string mensaje, ref string? error)
    {
        texto = texto?.Trim() ?? "";
        if (texto == "") return null;
        if (!texto.Contains(',')) texto = texto.Replace('.', ',');
        if (decimal.TryParse(texto, System.Globalization.NumberStyles.Number, new System.Globalization.CultureInfo("es-ES"), out var valor))
            return Math.Round(valor, 2);
        error = mensaje;
        return null;
    }

    private async Task Guardar()
    {
        errorCoste = errorHoras = errorGeneral = null;
        decimal? coste = Numero(f.Coste, "Escribe solo el importe, por ejemplo 180,50.", ref errorCoste);
        decimal? horas = Numero(f.Horas, "Escribe solo las horas, por ejemplo 1,5 (45 minutos = 0,75).", ref errorHoras);

        var registro = NoConformidadServicio.Normalizar(Registro(coste, horas));
        errores = NoConformidadServicio.Errores(registro);

        var leidas = new List<AccionNc>();
        bool accionesMal = false;
        foreach (var fila in acciones)
        {
            fila.Error = null;
            if (fila.Vacia) continue;
            var accion = fila.Leer();
            if (NoConformidadServicio.ErrorAccion(accion, registro.FechaDetectado) is string error)
            {
                fila.Error = error;
                accionesMal = true;
            }
            leidas.Add(accion);
        }

        hayErrores = errores.Count > 0 || errorCoste != null || errorHoras != null || accionesMal;
        if (hayErrores) return;

        guardando = true;
        await Task.Yield();   // para que se vean los botones desactivados mientras tanto
        try
        {
            string? antes = null;
            bool leidaAntes = registro.ProveedorId is int idAntes && Evaluacion(idAntes, out antes);

            int id;
            using (Sesion.Como(Usuario))
                id = servicio.Guardar(registro, leidas, fotos);
            guardada = true;

            // La evaluación del proveedor sale de sus NC: si pasa a pedir más controles, se avisa
            string? avisoProveedor = null;
            if (leidaAntes && registro.ProveedorId is int idProveedor && Evaluacion(idProveedor, out var despues)
                && ProveedorServicio.Empeora(antes, despues))
            {
                string cambio = antes == null ? $"pasa a tener la evaluación {despues}" : $"pasa de la evaluación {antes} a la {despues}";
                avisoProveedor = $"Con esta no conformidad, {registro.Proveedor} {cambio}.";
            }
            await OnGuardado.InvokeAsync((id, registro, avisoProveedor));
        }
        catch (ReglaNegocioException ex)
        {
            errorGeneral = ex.Message;
        }
        catch (DbException ex)
        {
            errorGeneral = "No se ha guardado. Comprueba la conexión y prueba otra vez. " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    // Si no se puede leer, no se avisa: el registro se guarda igual
    private static bool Evaluacion(int proveedorId, out string? evaluacion)
    {
        try
        {
            evaluacion = new ProveedorServicio().EvaluacionActual(proveedorId);
            return true;
        }
        catch (DbException)
        {
            evaluacion = null;
            return false;
        }
    }

    // Fotos: se leen al elegirlas (en el iPhone, Safari ya las pasa a JPG) y se guardan con el registro
    private async Task AnadirFotos(InputFileChangeEventArgs e)
    {
        errorFotos = null;
        leyendoFotos = true;
        try
        {
            foreach (var archivo in e.GetMultipleFiles(20))
            {
                if (NoConformidadServicio.ErrorFoto(archivo.Name, archivo.Size) is string error)
                {
                    errorFotos = error;
                    continue;
                }
                using var memoria = new MemoryStream();
                await archivo.OpenReadStream(NoConformidadServicio.TamanoMaximoFoto).CopyToAsync(memoria);
                fotos.Add(new ArchivoNuevo(archivo.Name, memoria.ToArray()));
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            errorFotos = "No se ha podido cargar la foto. Prueba otra vez. " + ex.Message;
        }
        finally
        {
            leyendoFotos = false;
            selecciones++;
        }
    }

    private static string Tamano(long bytes) =>
        bytes < 1024 * 1024 ? $"{bytes / 1024} KB" : $"{bytes / (1024.0 * 1024):0.0} MB";
}
