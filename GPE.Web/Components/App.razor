<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GPE.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="Interactivo" />
</head>

<body>
    <Routes @rendermode="Interactivo" />
    <ReconnectModal />
    <script src="@Assets["gpe.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sin prerenderizado: si no, cada página se cargaría dos veces (y leería dos veces la base de datos)
    private static readonly IComponentRenderMode Interactivo = new InteractiveServerRenderMode(prerender: false);
}
